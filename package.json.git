{
  "name": "@rn-form/form",
  "version": "3.5.1",
  "license": "UNLICENSED",
  "description": "react native form",
  "main": "lib/commonjs/index.js",
  "types": "lib/index.d.ts",
  "author": "SangLv <lsang2884@gmail.com>",
  "homepage": "https://github.com/LeVinhSang1234/NativeForm.git",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0"
  },
  "codegenConfig": {
    "name": "RNFormKeyboardManagerSpec",
    "type": "components",
    "jsSrcsDir": "packages",
    "ios": {
      "componentProvider": {
        "RNFormKeyboardManagerView": "RNFormKeyboardManagerView"
      }
    }
  },
  "scripts": {},
  "files": [
    "lib",
    "packages/",
    "ios/RNFormKeyboardManager/",
    "RNFormKeyboardManager.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeVinhSang1234/NativeForm.git"
  },
  "bugs": {
    "url": "https://github.com/LeVinhSang1234/NativeForm/issues"
  },
  "keywords": [
    "react native form",
    "rn-form"
  ]
}
